# ------------------------------------------------------------------
# AHV website environment variables
# Copy to .env.local and fill in the values. .env.local is gitignored.
# ------------------------------------------------------------------

# --- Supabase (logins + image storage) ---
# Project URL from Supabase dashboard > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Public "anon" API key from the same page. Safe for the browser; row-level
# security in supabase/migrations/0001_admin_media.sql restricts what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" API key. SERVER ONLY. Never expose to the browser, never
# commit it. Used to verify sessions, manage admin credentials and store images.
SUPABASE_SERVICE_ROLE_KEY=

# --- Session signing ---
# Secret used to sign the administrator session cookie (any long random string).
AHV_SESSION_SECRET=

# --- Local fallback only (used when Supabase envs are not set) ---
AHV_ADMIN_EMAIL=admin@africanhiddenvoices.co.za
AHV_ADMIN_PASSWORD=AHV-Admin-2026
